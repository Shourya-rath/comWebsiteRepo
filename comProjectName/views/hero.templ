package views

templ Hero() {
	<section class="min-h-screen flex items-center justify-center relative overflow-hidden paper-texture">
		@TextureOverlay()
		
		<div class="absolute w-[500px] h-[500px] rounded-full bg-[#C8A44D]/10 blur-3xl animate-float"></div>
		
		@FloatingPetals()
		
		<div class="diya-glow top-10 left-10"></div>
		<div class="diya-glow bottom-10 right-10"></div>
		
		<div class="content-width relative z-10 text-center py-20">
			<p class="subheading mt-6">
				Traditional Herbal Care
			</p>
			
			<h1 class="heading-font text-5xl md:text-7xl lg:text-8xl leading-tight mt-6 text-[#daa520b1]">
				Rooted In Nature,
				<br/>
				Crafted With Tradition
			</h1>
			
			@SectionDivider()
			
			<p class="max-w-3xl mx-auto text-lg md:text-xl leading-relaxed text-[#5A4638]">
				Herbal powders, teas, and natural wellness products
				inspired by generations of Indian herbal traditions,
				festive warmth, and handcrafted care.
			</p>
			
			<div class="mt-14 flex flex-wrap justify-center gap-5">
				<button class="primary-btn soft-shadow">
					Explore Products
				</button>
				<button class="secondary-btn">
					Learn More
				</button>
			</div>
			
			<div class="mt-16 inline-block border border-[#C8A44D]/40 px-8 py-4 rounded-full bg-[#F3E4D1]/60 backdrop-blur-sm">
				<span class="text-[#8C2F2F] tracking-[0.3em] uppercase text-sm">
					Inspired By Indian Festive Heritage
				</span>
			</div>
		</div>
	</section>
}