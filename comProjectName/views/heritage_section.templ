package views

templ HeritageSection() {
	<section class="py-20 relative">
		<div class="diya-glow top-10 left-10"></div>
		<div class="diya-glow bottom-0 right-10"></div>

		<div class="content-width">
			<div class="quote-panel px-10 py-24 text-center paper-texture">
				<p class="subheading">Inspired By Tradition</p>
				
				@SectionDivider()
				
				<h2 class="heading-font text-4xl md:text-6xl leading-relaxed max-w-4xl mx-auto">
					“Wellness begins with nature, tradition, and the warmth of mindful living.”
				</h2>
				<p class="mt-10 text-[#5A4638] max-w-2xl mx-auto leading-relaxed text-lg">
					Our herbal traditions are inspired by generations of Indian festive
					culture, handcrafted remedies, and natural ingredients.
				</p>
			</div>
		</div>
	</section>
}