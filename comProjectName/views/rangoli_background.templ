package views

import "strconv"

templ RangoliBackground() {
	<div class="rangoli-bg">
		<svg
			class="rangoli-svg"
			viewBox="0 0 500 500"
		>
			<defs>
				<radialGradient id="goldFade" cx="50%" cy="50%" r="50%">
					<stop offset="0%" stop-color="rgba(196,164,77,0.9)"></stop>
					<stop offset="60%" stop-color="rgba(196,164,77,0.4)"></stop>
					<stop offset="100%" stop-color="rgba(196,164,77,0.05)"></stop>
				</radialGradient>
			</defs>

			<circle
				cx="250"
				cy="250"
				r="200"
				stroke="url(#goldFade)"
				stroke-width="1.5"
				fill="none"
			></circle>

			for i := 0; i < 16; i++ {
				<g transform={ "rotate(" + strconv.Itoa((i * 360) / 16) + " 250 250)" }>
					<path
						d="
						M250 120
						C265 140, 285 140, 300 120
						C285 155, 265 155, 250 120
						"
						fill="none"
						stroke="rgba(196,164,77,0.55)"
						stroke-width="1.2"
					></path>
				</g>
			}

			<circle
				cx="250"
				cy="250"
				r="90"
				stroke="rgba(140,47,47,0.35)"
				stroke-width="1"
				fill="none"
			></circle>

			for i := 0; i < 8; i++ {
				<g transform={ "rotate(" + strconv.Itoa((i * 360) / 8) + " 250 250)" }>
					<path
						d="
						M250 200
						Q260 235 250 270
						Q240 235 250 200
						"
						fill="none"
						stroke="rgba(196,106,45,0.5)"
						stroke-width="1"
					></path>
				</g>
			}

			<circle
				cx="250"
				cy="250"
				r="6"
				fill="rgba(140,47,47,0.8)"
			></circle>
		</svg>
	</div>
}