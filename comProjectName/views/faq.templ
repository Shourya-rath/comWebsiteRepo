package views

type FAQItem struct {
	Question string
	Answer   string
}

var faqItems = []FAQItem{
	{
		Question: "What products can I buy at Shah Gebilal Heeralal Jain in Udaipur?",
		Answer:   "Shah Gebilal Heeralal Jain is a trusted general store in Udaipur offering a wide variety of everyday essentials, household products, and daily-use items for homes and businesses across the city.",
	},
	{
		Question: "Where is Shah Gebilal Heeralal Jain located?",
		Answer:   "Our store is located at Mandi Ki Nal, Krishi Upaj Mandi, Udaipur, Rajasthan, making us easy to reach for customers looking for a reliable general store near Krishi Upaj Mandi.",
	},
	{
		Question: "What are your store timings?",
		Answer:   "We are open daily from 10:00 AM to 8:30 PM, so you can shop for your daily essentials at a time that works best for you.",
	},
	{
		Question: "Why is Shah Gebilal Heeralal Jain a trusted general store in Udaipur?",
		Answer:   "Since 2009, we have been serving customers with quality products, honest pricing, and friendly customer service. Our focus on satisfaction has helped us become a preferred general store in Udaipur.",
	},
	{
		Question: "What payment methods do you accept?",
		Answer:   "For your convenience, we accept Cash, Visa, MasterCard, RuPay, American Express, Cheques, and Demand Drafts, making shopping quick and hassle-free.",
	},
	{
		Question: "Do you serve both retail customers and businesses?",
		Answer:   "Yes. We welcome individual shoppers, families, and businesses looking for dependable products and reliable service in Udaipur.",
	},
	{
		Question: "How can I contact Shah Gebilal Heeralal Jain?",
		Answer:   "You can call us using the contact number listed on our website or visit our store during business hours. Our team is happy to help with product inquiries and customer support.",
	},
	{
		Question: "What makes your general store different?",
		Answer:   "Our focus is on quality products, fair pricing, courteous service, and long-term customer relationships. We continuously work to improve our product selection and shopping experience.",
	},
	{
		Question: "Is your store easy to reach?",
		Answer:   "Yes. Our location in Krishi Upaj Mandi, Mandi Ki Nal, Udaipur is well connected by local transport, making it convenient for customers from different parts of the city.",
	},
	{
		Question: "Can your staff help me choose the right products?",
		Answer:   "Absolutely. Our experienced staff can answer your questions, help you find products quickly, and recommend suitable options based on your requirements.",
	},
	{
		Question: "Do you regularly add new products?",
		Answer:   "Yes. We regularly expand our product range to meet changing customer needs and ensure our shelves stay stocked with products our customers use every day.",
	},
	{
		Question: "Why should I choose a local general store in Udaipur?",
		Answer:   "Shopping at a local business like Shah Gebilal Heeralal Jain means personalized service, trusted product recommendations, competitive pricing, and the convenience of a neighborhood store serving the Udaipur community since 2009.",
	},
}

templ FAQSection() {
	<section class="py-24 md:py-32 relative paper-texture border-t border-[#C8A44D]/15">
		<div class="diya-glow top-8 left-8"></div>
		<div class="diya-glow bottom-8 right-8"></div>

		<div class="content-width relative z-10 px-4 md:px-0">
			<div class="text-center max-w-4xl mx-auto">
				<p class="subheading text-[#d86060] text-sm md:text-base">Frequently Asked Questions</p>
				<h2 class="heading-font text-4xl md:text-6xl lg:text-6xl mt-4 md:mt-6 text-[#daa520] leading-tight">
					Frequently Asked Questions
				</h2>

				@SectionDivider()

				<p class="max-w-3xl mx-auto text-base md:text-lg text-[#5A4638] leading-relaxed px-2">
					Find quick answers about our location, timings, payment methods, product range, and the trusted service we have offered in Udaipur since 2009.
				</p>
			</div>

			<div class="mt-12 md:mt-16 grid gap-4 md:gap-5 max-w-5xl mx-auto">
				for _, faq := range faqItems {
					<details class="group rounded-2xl border border-[#C8A44D]/20 bg-white/80 shadow-[0_10px_30px_rgba(123,87,34,0.08)] transition-colors duration-300 open:bg-[#fffaf2]">
						<summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-5 md:px-7 md:py-6 text-left text-lg md:text-xl font-semibold text-[#4e3b2c] leading-snug">
							<span>{ faq.Question }</span>
							<span class="faq-chevron flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-[#C8A44D]/30 bg-white text-[#C8A44D] transition-transform duration-300 group-open:rotate-45">
								+
							</span>
						</summary>
						<div class="px-5 pb-5 md:px-7 md:pb-7">
							<p class="max-w-4xl text-sm md:text-base leading-relaxed text-[#5A4638]">
								{ faq.Answer }
							</p>
						</div>
					</details>
				}
			</div>
            if false {

            <div class="mt-12 md:mt-16 grid gap-4 md:gap-5 max-w-5xl mx-auto">
                for _, faq := range faqItems {
                        <div class="collapse collapse-plus bg-white/80 rounded-2xl border border-[#C8A44D]/20 shadow-[0_10px_30px_rgba(123,87,34,0.08)]">
                            <input type="checkbox" />
                            <div class="collapse-title text-lg md:text-xl font-semibold text-[#4e3b2c] leading-snug pr-10">
                                { faq.Question }
                            </div>
                            <div class="collapse-content">
                                <p class="text-sm md:text-base leading-relaxed text-[#5A4638]">
                                    { faq.Answer }
                                </p>
                            </div>
                        </div>
                }
            </div>
            }
		</div>
	</section>
}