package views

templ ContactSection() {
	<section class="py-20 md:py-32 relative paper-texture">

		@RangoliBackground()
		@OrnamentalBorder("top-left",false)
		@OrnamentalBorder("top-right",false)
		@OrnamentalBorder("bottom-left",false)
		@OrnamentalBorder("bottom-right",false)

		<div class="diya-glow top-6 left-6 md:top-10 md:left-10"></div>
		<div class="diya-glow bottom-6 right-6 md:bottom-10 md:right-10"></div>

		<div class="content-width relative z-10 px-4 md:px-0">

			<!-- HEADER -->
			<div class="text-center">
				<p class="subheading text-[#d86060] text-sm md:text-base">
					Get In Touch
				</p>

				<h1 class="heading-font text-4xl md:text-6xl lg:text-7xl mt-4 md:mt-6 text-[#daa520] leading-tight">
					Contact Us
				</h1>

				@SectionDivider()

				<p class="max-w-2xl mx-auto text-base md:text-lg text-[#5A4638] leading-relaxed px-2">
					Visit our herbal stores or reach out for inquiries about our traditional wellness products.
				</p>
			</div>

			<!-- MAP -->
			<div class="mt-12 md:mt-20 contact-map-card">

				<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 px-6 md:px-10 pt-6 md:pt-10">
					<h2 class="heading-font text-3xl md:text-4xl text-[#E7C978]">
						Find Us
					</h2>

					<span class="text-[#C8A44D] text-[10px] md:text-xs tracking-[0.25em] uppercase">
						Krishi Upaj Mandi · Savina · Udaipur
					</span>
				</div>

				<div class="mt-6 md:mt-8 h-[320px] sm:h-[380px] md:h-[520px] w-full">
					<iframe
						class="w-full h-full"
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						src="https://www.google.com/maps?q=Krishi%20Upaj%20Mandi%20Savina%20Udaipur&output=embed">
					</iframe>
				</div>

			</div>

			<!-- FOOTER -->
			<div class="mt-16 md:mt-24 contact-info-footer">

				<div class="text-center">
					<p class="subheading text-[#d86060] text-sm md:text-base">
						Store Information
					</p>
					@SectionDivider()
				</div>

				<!-- responsive grid -->
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-10 mt-10 md:mt-12 " style="color: #ab9873;">

					@ContactCard(){
						<!-- <p class="contact-label ">Main Branch</p> -->
						@ContactLabel("Main Branch")
						<p class="mt-3 leading-relaxed text-sm md:text-base">
							72, Van Upaj Inside Dome<br/>
							Krish Upaj Mandi Savina, Udaipur
						</p>

					}
					

					@ContactCard(){
						@ContactLabel("Other Branch")
						<p class="mt-3 leading-relaxed text-sm md:text-base">
							33, Krishi Upaj Mandi Yard<br/>
							Savina, Udaipur
						</p>
					}

					<div class="contact-card flex flex-col items-center md:col-span-2 lg:col-span-1">
						@ContactLabel("Contact")

						<p class="mt-3 leading-relaxed text-sm md:text-base">
							<a class="text-[#8C2F2F] underline break-all"
							   href="mailto:shahgebilalheeralaljain@gmail.com">
								shahgebilalheeralaljain@gmail.com
							</a>
							<br/>
							8209433968<br/>
							9460029338<br/>
							9468711060<br/>

						</p>
					</div>

				</div>

			</div>

		</div>
	</section>
}

templ ContactCard() {
	<div class="contact-card flex flex-col items-center">
	{children...}
	</div>
}
templ ContactLabel(label string) {
	<p class="contact-label font-bold underline">{label}</p>
}