package components

templ LuxurySectionHeader(eyebrow, title, description string) {
    <div class="max-w-3xl">
        <div class="inline-flex items-center gap-3 rounded-full border border-warning/30 bg-base-100/60 px-4 py-2 backdrop-blur-sm">
            <span class="h-2 w-2 rounded-full bg-warning"></span>
            <span class="text-[0.65rem] font-semibold uppercase tracking-[0.32em] text-warning">{ eyebrow }</span>
        </div>
        <h2 class="mt-5 text-3xl font-semibold tracking-tight text-base-content md:text-5xl">{ title }</h2>
        <p class="mt-4 max-w-2xl text-sm leading-7 text-base-content/70 md:text-base">{ description }</p>
    </div>
}

templ MasonryValueCard(title, description, className string) {
    <article class={ "group h-full rounded-[1.75rem] border border-warning/20 bg-base-100/80 p-6 shadow-xl backdrop-blur-sm transition-all hover:scale-[1.02] md:p-8 " + className }>
        <div class="flex items-start justify-between gap-4">
            <h3 class="text-xl font-semibold tracking-tight text-base-content md:text-2xl">{ title }</h3>
            <span class="mt-1 h-3 w-3 rounded-full bg-warning/80"></span>
        </div>
        <p class="mt-4 text-sm leading-7 text-base-content/70 md:text-base">{ description }</p>
        <div class="mt-6 h-px w-full bg-gradient-to-r from-warning/40 via-base-content/10 to-transparent"></div>
        <div class="mt-4 text-[0.65rem] uppercase tracking-[0.3em] text-base-content/45">Placeholder micro-detail</div>
    </article>
}

templ SpotlightPanel(title, description, note string, bullets []string, className string) {
    <section class={ "rounded-[2rem] border border-base-content/10 bg-base-100/75 p-6 shadow-2xl backdrop-blur-sm transition-all hover:scale-[1.02] md:p-8 " + className }>
        <div class="flex items-center justify-between gap-4">
            <div>
                <p class="text-[0.65rem] font-semibold uppercase tracking-[0.34em] text-warning">Premium local spotlight</p>
                <h3 class="mt-3 text-2xl font-semibold tracking-tight text-base-content">{ title }</h3>
            </div>
            <div class="rounded-full border border-warning/30 px-3 py-2 text-xs font-medium text-warning">
                {note}
            </div>
        </div>

        <p class="mt-4 max-w-xl text-sm leading-7 text-base-content/70 md:text-base">{ description }</p>

        <div class="mt-6 space-y-3">
            for _, bullet := range bullets{
                <div class="flex items-start gap-3 rounded-2xl border border-base-content/10 bg-base-200/50 px-4 py-3">
                    <span class="mt-1 h-2.5 w-2.5 rounded-full bg-warning"></span>
                    <p class="text-sm leading-6 text-base-content/75">{ bullet }</p>
                </div>
            }
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-3">
            <a href="#" class="inline-flex items-center rounded-full border border-warning/30 bg-warning/10 px-5 py-3 text-sm font-medium text-warning transition-all hover:scale-[1.02]">
                Primary CTA
            </a>
            <a href="#" class="inline-flex items-center rounded-full border border-base-content/10 px-5 py-3 text-sm font-medium text-base-content/70 transition-all hover:scale-[1.02]">
                Secondary CTA
            </a>
        </div>
    </section>
}

templ HeritageTimelineItem(year, title, description string) {
    <div class="relative pl-6 md:pl-8">
        <div class="absolute left-0 top-2 h-3 w-3 rounded-full bg-warning"></div>
        <div class="absolute left-[5px] top-5 h-full w-px bg-warning/30"></div>

        <div class="rounded-[1.5rem] border border-base-content/10 bg-base-100/70 p-5 backdrop-blur-sm md:p-6">
            <div class="flex flex-wrap items-center gap-3">
                <span class="rounded-full border border-warning/30 px-3 py-1 text-xs font-semibold uppercase tracking-[0.28em] text-warning">{ year }</span>
                <h3 class="text-lg font-semibold tracking-tight text-base-content md:text-xl">{ title }</h3>
            </div>
            <p class="mt-3 text-sm leading-7 text-base-content/70 md:text-base">{ description }</p>
        </div>
    </div>
}