package components

templ ShopUdaipurPage() {
    @Layout(SiteMeta{
        Title:       "Shop Udaipur | Premium Local Ayurvedic Store",
        Description: "Premium local search landing page for Udaipur with store visibility, heritage-first positioning, and luxury Ayurvedic presentation.",
        Canonical:   "/shop-udaipur",
    }) {
        <main class="min-h-screen bg-base-200 text-base-content">
            <section class="px-6 py-6 md:px-12 md:py-12">
                <div class="overflow-hidden rounded-[2.5rem] border border-warning/20 bg-base-100/75 shadow-2xl backdrop-blur-sm">
                    <div class="grid gap-10 p-6 md:p-12 lg:grid-cols-12 lg:items-center">
                        <div class="lg:col-span-7">
                            <div class="inline-flex items-center gap-3 rounded-full border border-warning/30 bg-base-100/60 px-4 py-2 backdrop-blur-sm">
                                <span class="h-2 w-2 rounded-full bg-warning"></span>
                                <span class="text-[0.65rem] font-semibold uppercase tracking-[0.32em] text-warning">Local Search Landing</span>
                            </div>

                            <h1 class="mt-5 max-w-3xl text-4xl font-semibold tracking-tight text-base-content md:text-6xl">
                                Premium Ayurvedic Store in <span class="text-warning">Udaipur</span>
                            </h1>

                            <p class="mt-5 max-w-2xl text-sm leading-7 text-base-content/70 md:text-base">
                                Placeholder hero narrative for Udaipur-local intent, heritage trust, and premium herbal positioning.
                            </p>

                            <div class="mt-8 flex flex-wrap items-center gap-3">
                                <a href="#" class="inline-flex items-center rounded-full border border-warning/30 bg-warning/10 px-6 py-3 text-sm font-medium text-warning transition-all hover:scale-[1.02]">
                                    Primary Local CTA
                                </a>
                                <a href="#" class="inline-flex items-center rounded-full border border-base-content/10 px-6 py-3 text-sm font-medium text-base-content/70 transition-all hover:scale-[1.02]">
                                    Secondary Action
                                </a>
                            </div>
                        </div>

                        <div class="lg:col-span-5">
                            <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-1">
                                <div class="rounded-[2rem] border border-base-content/10 bg-base-200/50 p-5 backdrop-blur-sm transition-all hover:scale-[1.02]">
                                    <div class="flex items-center justify-between">
                                        <p class="text-xs uppercase tracking-[0.3em] text-warning">Udaipur Presence</p>
                                        <span class="rounded-full border border-warning/30 px-3 py-1 text-[0.65rem] text-warning">Premium</span>
                                    </div>
                                    <p class="mt-4 text-lg font-semibold text-base-content">Store facade / local landmark placeholder</p>
                                    <p class="mt-3 text-sm leading-7 text-base-content/65">Short supporting copy placeholder.</p>
                                </div>

                                <div class="rounded-[2rem] border border-warning/20 bg-base-100/80 p-5 shadow-xl backdrop-blur-sm transition-all hover:scale-[1.02]">
                                    <p class="text-xs uppercase tracking-[0.3em] text-warning">Trust Metric</p>
                                    <p class="mt-4 text-4xl font-semibold text-base-content">01</p>
                                    <p class="mt-2 text-sm leading-7 text-base-content/65">Local credibility placeholder with gold-accent detail.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="px-6 py-6 md:px-12 md:py-12">
                @LuxurySectionHeader(
                    "Udaipur Spotlights",
                    "Two-column local feature experience",
                    "Placeholder supporting text for physical store visibility, neighborhood relevance, and premium Ayurvedic discovery.",
                ) 

                <div class="mt-8 grid gap-6 lg:grid-cols-2">
                    @SpotlightPanel(
                        "Visit our Physical Store",
                        "Placeholder location-led copy describing the store destination experience, premium service feel, and in-person guidance.",
                        "Local Visit",
                        []string{
                            "Store address placeholder",
                            "Hours / service placeholder",
                            "Premium consultation placeholder",
                        },
                        "",
                    ) 

                    @SpotlightPanel(
                        "Udaipur Service Zone",
                        "Placeholder neighborhood copy for delivery, accessibility, and intent-aligned local discovery.",
                        "Nearby Areas",
                        []string{
                            "Area coverage placeholder",
                            "Local pickup placeholder",
                            "Response / support placeholder",
                        },
                        "",
                    ) 
                </div>
            </section>

            <section class="px-6 py-6 md:px-12 md:py-12">
                @LuxurySectionHeader(
                    "Store Values",
                    "Masonry-style premium value cards",
                    "Placeholder value narrative for purity, craftsmanship, trust, and heritage-led Ayurvedic shopping.",
                ) 

                <div class="mt-8 grid auto-rows-fr gap-6 md:grid-cols-2 xl:grid-cols-3">
                    @MasonryValueCard(
                        "Pure Herbal Sourcing",
                        "Placeholder copy about ingredient quality, selection discipline, and premium natural standards.",
                        "xl:row-span-2",
                    ) 

                    @MasonryValueCard(
                        "Traditional Care",
                        "Placeholder copy for Ayurvedic knowledge, classical methods, and thoughtful guidance.",
                        "",
                    )

                    @MasonryValueCard(
                        "Elegant Service",
                        "Placeholder copy about consultation warmth, refined hospitality, and structured customer support.",
                        "",
                    ) 

                    @MasonryValueCard(
                        "Local Trust",
                        "Placeholder copy for Udaipur recognition, community presence, and enduring reputation.",
                        "md:col-span-2 xl:col-span-1",
                    ) 
                </div>
            </section>
        </main>
    }
}