package components

import (
    "strconv"
    "time"
    "fmt"

    "comProjectName/backend"
    )
templ Layout(title string) {
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>


        <!-- Datastar CDN -->
        <script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@1.0.0-RC.8/bundles/datastar.js">
        </script>
        
        <!-- Tailwind + DaisyUI CDN -->
                
        <!-- Custom style-sheet -->
        {{var StyleVersion = fmt.Sprintf("%d", time.Now().Unix())}}
        <link rel="stylesheet" href={ "/static/css/output.css?v=" + StyleVersion }>
        <!-- <link rel="stylesheet" href="/static/css/output.css"/> -->
        <link rel="stylesheet" href="/static/css/theme.css"/>
        
    </head>
    if false{
        <body class="bg-base-200 paper-texture min-h-screen relative overflow-x-hidden"></body>
    }
    // Change the body tag in your template to dynamically read your theme variable:
    <body class="paper-texture min-h-screen relative overflow-x-hidden" style="background-color: var(--bg);">
               
        <nav class="festive-navbar">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="heading-font text-3xl text-[#4E5B31]">
                        <a href="/">Home</a>
                    </h1>
                    <p class="text-xs tracking-[0.25em] uppercase text-[#8C2F2F]">
                        Herbal Traditions
                    </p>
                </div>
                <div class="flex items-center gap-6 text-[#5A4638]">
                    <a href="/shop" class="hover:text-[#8C2F2F] transition-colors">Collection</a>
                    if false {
                        <button class="btn btn-ghost text-lg">Cart 🛒</button> 
                    }
                    <a href="/contact" class="hover:text-[#8C2F2F] transition-colors">Contact Us</a>
                </div>
            </div>
        </nav>
        
        <main class="page-container">
            // @SearchSection(arr) 
            {children...}
        </main>
    </body>
    </html>
}
templ CategoryBreadcrumb(str string){
    if false{ 
        <button class="px-5 py-2 border border-[#C8A44D]/40 text-sm tracking-wide 
        text-[#5A4638] rounded-full bg-[#F3E4D1]/40 hover:bg-[#4E5B31] hover:text-white transition-all duration-300" 
                onclick="filterCategory('str')">
            {str}
        </button> 
    }
    
    
    <button class="px-5 py-2 border border-[#C8A44D]/30 text-sm tracking-wide text-[#D9BC72] rounded-full bg-[#1A1612]/60 hover:bg-[#4E5B31] hover:text-white hover:border-[#4E5B31] transition-all duration-300 cursor-pointer" 
            onclick="filterCategory('str')">
        {str}
  </button>


}
/*
contains everything in page except the Nav Bar
*/
templ SearchSection(products_arr []backend.Product){
    @Layout("Vanaushadhi - Complete Collection"){
        <div class="content-width py-16 relative z-10" data-signals="{search: ''}">
            
            <div class="text-center mb-16">
                <p class="subheading text-[#d86060]">Artesian Catalog</p>
                <h1 class="heading-font text-5xl mt-4 text-[#daa520]">Search Traditional Powders</h1>
            </div>

            if false {
                <div class="max-w-3xl mx-auto mb-12">
                    <div class="flex gap-3 bg-[#F3E4D1]/40 p-2 rounded-xl border border-[#C8A44D]/30 backdrop-blur-sm">
                        <input id="searchInput"
                            type="text"
                            data-bind="search"
                            data-on:input__debounce.500ms="@post('/shop/search')"
                            data-on:keydown="evt.key === 'Enter' && @post('/shop/search')"
                            placeholder="Search wellness mixes, herbal teas..."
                            class="input input-bordered w-full bg-white/70 border-[#C8A44D]/20 focus:border-[#4E5B31] focus:outline-none" />

                        <button data-on:click="@post('/shop/search')"
                                class="primary-btn shrink-0 py-2 px-6">
                            Search
                        </button>
                    </div>
                </div> 
            }

            <div class="max-w-3xl mx-auto mb-12">
                <div class="flex gap-3 bg-[#12100E] p-2 rounded-xl border border-[#C8A44D]/25 backdrop-blur-sm shadow-xl">
                    <input id="searchInput"
                        type="text"
                        data-bind="search"
                        data-on:input__debounce.500ms="@post('/shop/search')"
                        data-on:keydown="evt.key === 'Enter' && @post('/shop/search')"
                        placeholder="Search wellness mixes, herbal teas..."
                        class="input input-bordered w-full bg-[#1A1713] text-[#F3E4D1] border-[#C8A44D]/15 focus:border-[#4E5B31] focus:outline-none placeholder:text-neutral-500" />

                    <button data-on:click="@post('/shop/search')"
                            class="primary-btn shrink-0 py-2 px-6">
                        Search
                    </button>
                </div>
            </div>


            <div class="mb-12 flex flex-wrap justify-center gap-4">
                @CategoryBreadcrumb("All Collections")
                @CategoryBreadcrumb("Wellness")
                @CategoryBreadcrumb("Skincare")
                @CategoryBreadcrumb("Hair Care")
            </div>

            <div id="productGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-3 xl:grid-cols-4 gap-8">
                if (len(products_arr) == 0) {
                    <div class="col-span-full festive-panel text-center py-16">
                        <p class="text-xl text-[#E9E2D5]">No traditional blends found matching your criteria 😢</p>
                    </div>
                } else {
                    @ProductGridItems(products_arr)       
                }
            </div>

            <div id="pagination-wrapper" class="mt-16 flex justify-center w-full">
                if len(products_arr) > 0 {
                    @LoadMoreButton(products_arr[len(products_arr)-1].ID)
                } 
            </div>   
        </div>
    }
}
templ LoadMoreButton(lastID int){
    <button id="pagination-controls" 
            class="secondary-btn border-[#C8A44D] text-[#D9BC72] hover:bg-[#C8A44D]/15 cursor-pointer"
    data-on:click={ 
        "@post('/shop/next?lastID=' + " + 
        strconv.Itoa(lastID) + ")" 
    }
    >
        Load More Collections
    </button>
}
templ ProductGridItems(products_arr []backend.Product) {
    if (len(products_arr) == 0) {
            <p class="text-center col-span-full">No products found 😢</p>
    }
    else{
        for _, product := range products_arr {
            if false {
                <li>{ product.NameEn }</li>
            }
            @ProductCard(product)
        }
    }
}

/* if (items.length === 0) {
grid.innerHTML = `<p class="text-center col-span-full">No products found 😢</p>`;
return;
} */
templ ProductCard(product backend.Product){
    {{ var image_url string = "https://img.magnific.com/premium-vector/acorn-logo-design-concept_761413-6644.jpg?semt=ais_hybrid&w=740&q=80" }}
    if product.Image != nil {
        {{ image_url = *product.Image }}
    }
    
    <div class="group bg-[#12100E] border border-[#C8A44D]/20 rounded-2xl overflow-hidden transition-all duration-300 hover:-translate-y-1.5 hover:border-[#C8A44D]/60 hover:shadow-[0_10px_30px_rgba(200,164,77,0.1)]">
        
        <div class="h-64 overflow-hidden relative bg-[#1A1612] border-b border-[#C8A44D]/10 p-4">
            <img src={ image_url } 
                 alt={ product.NameEn } 
                 class="w-full h-full object-cover rounded-xl transform transition-transform duration-500 group-hover:scale-103" />
        </div>

        <div class="p-6 relative z-10">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium uppercase tracking-wider text-[#D9BC72] bg-[#C8A44D]/10 px-2.5 py-0.5 rounded-md">
                    if product.Category != "" { 
                        { product.Category } } 
                    else { 
                        Traditions 
                    }
                </span>
                <div class="text-[#C8A44D]/60 text-sm">✦</div>
            </div>

            <h3 class="heading-font text-xl mt-3 text-[#F3E4D1] leading-tight min-h-[3rem] line-clamp-2">
                { product.NameEn }
            </h3>
            if false{ 
                <p class="text-[#A69282] text-sm leading-relaxed mt-2 line-clamp-2">
                    if product.Description != nil { 
                        { *product.Description } 
                    } else { 
                        Infused with time-tested ayurvedic methodologies. 
                    }
                </p> 
            }
            <p class="text-[#A69282] font-bold text-lg leading-relaxed mt-2 line-clamp-2">
                {product.NameHi}
            </p>

            <div class="mt-6 flex items-center justify-between pt-4 border-t border-[#C8A44D]/10">
                <span class="text-xl font-bold text-[#D9BC72]">
                    if false {
                        ₹{ strconv.Itoa(product.Price) }
                    }
                    In stock
                </span>
                <a href={ templ.URL("/products/" + product.Slug) }
                   class="primary-btn text-xs py-2 px-4 shadow-sm hover:opacity-90">
                    View Product
                </a>
            </div>
        </div>
    </div>
}

templ ProductPageView(product backend.Product){
    {{ var image_url string = "https://img.magnific.com/premium-vector/acorn-logo-design-concept_761413-6644.jpg?semt=ais_hybrid&w=740&q=80" }}
    if product.Image != nil {
        {{ image_url = *product.Image }}
    }

    @Layout(product.NameEn + " - Vanaushadhi"){
        <div class="max-w-6xl mx-auto p-6 my-12 relative">
            
            <div class="diya-glow -top-10 -left-10 opacity-60"></div>
            
            <div id="productContainer" class="grid md:grid-cols-2 gap-12 items-start text-[#eaeaea] bg-[#020a29] p-8 md:p-12 rounded-3xl border border-[#C8A44D]/20 backdrop-blur-sm">
    
                <div class="flex justify-center relative group">
                    <div class="absolute inset-0 bg-[#C8A44D]/5 rounded-2xl blur-xl transition-all"></div>
                    <img src={ image_url } 
                        class="rounded-2xl border border-[#C8A44D]/30 shadow-lg w-full max-w-md object-cover aspect-square relative z-10" />
                </div>

                <div class="relative z-10">
                    <span class="text-xs font-semibold tracking-[0.2em] uppercase text-[#D9BC72] bg-[#C8A44D]/15 px-3 py-1 rounded-full">
                        { product.Category }
                    </span>
                    
                    <h1 class="heading-font text-4xl md:text-5xl mt-4 mb-2 text-app-primary">{ product.NameEn }</h1>
                    
                    <div class="w-20 h-[2px] bg-[#C8A44D]/40 my-4"></div>
                    if false{
                        <p class="text-3xl font-semibold text-[#D9BC72] mb-6">₹{ strconv.Itoa(product.Price) }</p>
                    }
                    <h4 class="text-xs uppercase tracking-wider font-bold text-[#8C2F2F] mb-2">Description</h4>
                    <p class="mb-8 text-app-muted leading-relaxed text-lg">
                        if product.Description != nil { 
                            { *product.Description } 
                        } else { 
                            Hand-milled using legacy methodologies. 
                        }
                    </p>

                    if false{ 
                        <div class="flex items-center gap-4 mb-8">
                            <span class="text-sm font-medium text-app-muted">Quantity:</span>
                            <input type="number" value="1" min="1" 
                                class="input input-bordered w-24 text-center bg-[#1A1713] text-app-primary border-[#C8A44D]/30 focus:outline-none focus:border-[#4E5B31]" />
                        </div> 
                    }

                    <div class="flex flex-wrap gap-4">
                        if false {
                            <button class="primary-btn shadow-md text-base px-8 py-3">
                                Add to Cart 🛒
                            </button>
                        }
                        <a href="/shop" class="secondary-btn text-base px-8 py-3 text-center border-[#C8A44D]/40 text-[#D9BC72] hover:bg-[#C8A44D]/10">
                            Back to Collection
                        </a>
                    </div>
                </div>  
            </div>
            
        </div>         
    }
}