package components

templ AboutPage() {
    @Layout(SiteMeta{
        Title:       "About Us | Heritage Ayurvedic Store",
        Description: "Elegant about page with split biography layout and heritage timeline for a premium Ayurvedic brand story.",
        Canonical:   "/about",
    }) {
        <main class="min-h-screen bg-base-200 text-base-content">
            <section class="px-6 py-6 md:px-12 md:py-12">
                <div class="grid gap-8 lg:grid-cols-12">
                    <div class="lg:col-span-5">
                        <div class="relative overflow-hidden rounded-[2.5rem] border border-warning/20 bg-base-100/75 shadow-2xl backdrop-blur-sm">
                            <div class="aspect-[4/5] w-full bg-base-300/50"></div>

                            <div class="absolute inset-0 bg-gradient-to-t from-base-100/90 via-base-100/20 to-transparent"></div>

                            <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
                                <div class="inline-flex items-center gap-3 rounded-full border border-warning/30 bg-base-100/60 px-4 py-2 backdrop-blur-sm">
                                    <span class="h-2 w-2 rounded-full bg-warning"></span>
                                    <span class="text-[0.65rem] font-semibold uppercase tracking-[0.32em] text-warning">Heritage Portrait Placeholder</span>
                                </div>
                                <p class="mt-4 max-w-md text-sm leading-7 text-base-content/75">
                                    Placeholder image caption for founder story, craft, and tradition.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="lg:col-span-7">
                        <div class="rounded-[2.5rem] border border-base-content/10 bg-base-100/75 p-6 shadow-2xl backdrop-blur-sm md:p-12">
                            <p class="text-[0.65rem] font-semibold uppercase tracking-[0.34em] text-warning">About the Store</p>
                            <h1 class="mt-4 text-4xl font-semibold tracking-tight text-base-content md:text-6xl">
                                A heritage narrative built on <span class="text-warning">pure herbal tradition</span>
                            </h1>
                            <p class="mt-5 max-w-3xl text-sm leading-7 text-base-content/70 md:text-base">
                                Placeholder biographical summary for the store’s origin, philosophy, and premium Ayurvedic identity.
                            </p>

                            <div class="mt-8 grid gap-4 sm:grid-cols-2">
                                <div class="rounded-[1.5rem] border border-warning/20 bg-base-200/50 p-5 backdrop-blur-sm">
                                    <p class="text-xs uppercase tracking-[0.3em] text-warning">Principle One</p>
                                    <p class="mt-3 text-lg font-semibold text-base-content">Purity-first formulation</p>
                                    <p class="mt-2 text-sm leading-7 text-base-content/65">Placeholder detail.</p>
                                </div>
                                <div class="rounded-[1.5rem] border border-warning/20 bg-base-200/50 p-5 backdrop-blur-sm">
                                    <p class="text-xs uppercase tracking-[0.3em] text-warning">Principle Two</p>
                                    <p class="mt-3 text-lg font-semibold text-base-content">Warm customer guidance</p>
                                    <p class="mt-2 text-sm leading-7 text-base-content/65">Placeholder detail.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="px-6 py-6 md:px-12 md:py-12">
                @LuxurySectionHeader(
                    "Heritage Timeline",
                    "Elegant timeline accents for store history",
                    "Placeholder chronology describing milestones, values, and the long-term commitment to authentic herbal traditions.",
                ) 

                <div class="mt-8 grid gap-5">
                    @HeritageTimelineItem(
                        "Year Placeholder",
                        "Founding moment",
                        "Placeholder copy for the initial vision, early trust, and foundational positioning.",
                    ) 
                    @HeritageTimelineItem(
                        "Year Placeholder",
                        "Tradition refined",
                        "Placeholder copy for product depth, service consistency, and growing local reputation.",
                    ) 
                    @HeritageTimelineItem(
                        "Year Placeholder",
                        "Modern premium era",
                        "Placeholder copy for elevated presentation, responsive customer experience, and future-forward growth.",
                    ) 
                </div>
            </section>

            <section class="px-6 py-6 md:px-12 md:py-12">
                <div class="grid gap-6 lg:grid-cols-3">
                    @MasonryValueCard(
                        "Commitment to Purity",
                        "Placeholder copy describing ingredient discipline and quality assurance.",
                        "lg:col-span-1",
                    ) 
                    @MasonryValueCard(
                        "Respect for Heritage",
                        "Placeholder copy describing classical roots, tradition, and disciplined preparation.",
                        "lg:col-span-1",
                    ) 
                    @MasonryValueCard(
                        "Premium Support Experience",
                        "Placeholder copy describing guidance, service warmth, and polished in-store interactions.",
                        "lg:col-span-1",
                    ) 
                </div>
            </section>
        </main>
    }
}